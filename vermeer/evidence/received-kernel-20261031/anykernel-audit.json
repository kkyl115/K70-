    "tools/ak3-core.sh": [
      {
        "line": 82,
        "text": "dd if=$BLOCK of=$BOOTIMG $CUSTOMDD;"
      },
      {
        "line": 191,
        "text": "### write_boot functions:"
      },
      {
        "line": 220,
        "text": "if [ ! \"$NO_MAGISK_CHECK\" ]; then"
      },
      {
        "line": 246,
        "text": "# flash_boot (build, sign and write image only)"
      },
      {
        "line": 247,
        "text": "flash_boot() {"
      },
      {
        "line": 325,
        "text": "if [ ! \"$magisk_patched\" -a ! \"$NO_MAGISK_CHECK\" ]; then"
      },
      {
        "line": 385,
        "text": "unset magisk_patched KEEPVERITY KEEPFORCEENCRYPT RECOVERYMODE PREINITDEVICE SHA1 RANDOMSEED; # leave PATCHVBMETAFLAG set for repack"
      },
      {
        "line": 391,
        "text": "case $PATCH_VBMETA_FLAG in"
      },
      {
        "line": 392,
        "text": "auto|\"\") [ \"$PATCHVBMETAFLAG\" ] || export PATCHVBMETAFLAG=false;;"
      },
      {
        "line": 393,
        "text": "1) export PATCHVBMETAFLAG=true;;"
      },
      {
        "line": 394,
        "text": "*) export PATCHVBMETAFLAG=false;;"
      },
      {
        "line": 401,
        "text": "[ \"$PATCHVBMETAFLAG\" ] && unset PATCHVBMETAFLAG;"
      },
      {
        "line": 446,
        "text": "dd if=/dev/zero of=$BLOCK $CUSTOMDD 2>/dev/null;"
      },
      {
        "line": 447,
        "text": "dd if=boot-new.img of=$BLOCK $CUSTOMDD;"
      },
      {
        "line": 449,
        "text": "cat boot-new.img /dev/zero > $BLOCK 2>/dev/null || true;"
      },
      {
        "line": 506,
        "text": "if [ -d /postinstall/tmp -a \"$SLOT_SELECT\" == \"inactive\" ]; then"
      },
      {
        "line": 544,
        "text": "dd if=/dev/zero of=$imgblock 2>/dev/null;"
      },
      {
        "line": 545,
        "text": "dd if=$img of=$imgblock;"
      },
      {
        "line": 565,
        "text": "### write_boot (repack ramdisk then build, sign and write image, vendor_dlkm and dtbo)"
      },
      {
        "line": 566,
        "text": "write_boot() {"
      },
      {
        "line": 568,
        "text": "flash_boot;"
      },
      {
        "line": 818,
        "text": "[ \"$patch_vbmeta_flag\" ] && PATCH_VBMETA_FLAG=\"$patch_vbmeta_flag\";"
      },
      {
        "line": 820,
        "text": "[ \"$slot_select\" ] && SLOT_SELECT=\"$slot_select\";"
      },
      {
        "line": 822,
        "text": "[ \"$no_magisk_check\" ] && NO_MAGISK_CHECK=\"$no_magisk_check\";"
      },
      {
        "line": 823,
        "text": "unset block is_slot_device ramdisk_compression patch_vbmeta_flag customdd slot_select no_block_display no_magisk_check;"
      },
      {
        "line": 837,
        "text": "if [ -d /postinstall/tmp -a ! \"$SLOT_SELECT\" ]; then"
      },
      {
        "line": 838,
        "text": "SLOT_SELECT=inactive;"
      },
      {
        "line": 840,
        "text": "case $SLOT_SELECT in"
